# Copy to .env on the host (chmod 600). Never commit .env.
# Placeholders below are examples. Defaults match the code when a variable is unset.

# --- process ---
MINDPROBE_ENV=production
MINDPROBE_AUTH_COOKIE=false
# Required in production. 64 hex characters. A missing value makes the process
# generate a secret that dies on restart.
MINDPROBE_WS_TOKEN_SECRET=replace-with-64-hex-characters
MINDPROBE_OPERATOR_TOKEN=replace-with-a-long-random-string
# Three Vite origins. Replace the example hostnames; do not commit real project names.
MINDPROBE_CORS_ORIGINS=https://student.example.vercel.app,https://wizard.example.vercel.app,https://teacher.example.vercel.app
MINDPROBE_UPLOAD_GRACE_SECONDS=600
# Blank: do not invent recording rows for sessions that already ended.
# fresh, or an ISO-8601 instant such as 2026-10-20T00:00:00Z. See
# docs/deployment-readiness.md.
MINDPROBE_UPLOAD_GRACE_SYNTHESIZE_AFTER=
MINDPROBE_REVIEW_ACCESS_TTL=1800
MINDPROBE_REVIEW_REFRESH_TTL=604800

# --- storage ---
# local is enough for a smoke test. s3 selects the R2/S3 adapter (needs boto3).
MINDPROBE_STORAGE_BACKEND=local
MINDPROBE_S3_ENDPOINT=https://example-account.r2.cloudflarestorage.com
MINDPROBE_S3_REGION=auto
MINDPROBE_S3_ACCESS_KEY_ID=
MINDPROBE_S3_SECRET_ACCESS_KEY=
# Public case-media bucket. Empty keeps cases/ keys on the recordings bucket.
MINDPROBE_MEDIA_BUCKET=mindprobe-media
# Private recordings and sqlite backups. Required when STORAGE_BACKEND=s3.
MINDPROBE_RECORDINGS_BUCKET=mindprobe-recordings
# Public base for case media (r2.dev during the trial). Not a secret.
MINDPROBE_MEDIA_BASE_URL=https://pub-example.r2.dev
# Presigned recording GET lifetime. Default 900. Allowed 1-86400.
MINDPROBE_PRESIGN_TTL_SECONDS=900

# --- disk and ffmpeg ---
# /health disk.level becomes warn when used percent exceeds this. Default 70.
MINDPROBE_DISK_WARN_PCT=70
# POST /sessions returns 507 when free space is below this many GiB. Default 5.
MINDPROBE_DISK_MIN_FREE_GB=5
# libx264 -threads / -preset. Defaults 2 / veryfast. Threads allowed 1-32.
MINDPROBE_FFMPEG_THREADS=2
MINDPROBE_FFMPEG_PRESET=veryfast

# --- Caddy / proxy (docker-compose.prod.yml) ---
# Trial hostname is the Lightsail static IP as A-B-C-D.sslip.io.
# Local smoke test: localhost (Caddy internal certificate).
MINDPROBE_API_HOST=localhost
# Trust X-Forwarded-* from these IPs. `*` is safe only while port 8000 is not published.
FORWARDED_ALLOW_IPS=*

# --- Vercel build env (set on each frontend project, not on the API host) ---
# VITE_API_BASE_URL=https://1-2-3-4.sslip.io
# VITE_MEDIA_BASE_URL=https://pub-example.r2.dev
